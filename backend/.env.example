APP_NAME=KisanSetu API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./kisansetu.db
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Development-only values. Staging/production require PostgreSQL and unique
# random credentials (never commit a real .env file).
OPERATOR_ACCESS_TOKEN=local-operator
AUTH_SECRET_KEY=development-only-change-me
# The OTP limiter is process-local. Use shared storage or an API gateway when
# running multiple workers/instances.
OTP_REQUEST_LIMIT=5
OTP_VERIFY_LIMIT=10
OTP_RATE_LIMIT_WINDOW_SECONDS=60

# Production example (replace every value; do not use these sample credentials):
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://user:password@db:5432/kisansetu
