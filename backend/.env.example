APP_NAME=KisanSetu API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./kisansetu.db
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Development-only values. In non-development environments both credentials
# are required, must be random, and must not use these defaults.
OPERATOR_ACCESS_TOKEN=local-operator
AUTH_SECRET_KEY=development-only-change-me
# The OTP limiter is process-local. Use shared storage or an API gateway when
# running multiple workers/instances.
OTP_REQUEST_LIMIT=5
OTP_VERIFY_LIMIT=10
OTP_RATE_LIMIT_WINDOW_SECONDS=60
